<Window x:Class="CrtSharp.ConfigPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置文件密码" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#1E1E1E">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Foreground="#DDDDDD" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Text="密码" Foreground="#AAAAAA" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordBox" Height="28" Padding="6,4"/>
        <TextBlock x:Name="ConfirmLabel" Text="确认密码" Foreground="#AAAAAA" Margin="0,10,0,4"/>
        <PasswordBox x:Name="ConfirmBox" Height="28" Padding="6,4"/>
        <TextBlock x:Name="ErrorText" Foreground="#F08080" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="确定" Width="80" Height="28" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="28" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
