<Window x:Class="CrtSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrtSharp" Height="780" Width="1280" MinHeight="560" MinWidth="900"
        Icon="pack://application:,,,/Assets/CrtSharp.ico"
        Background="#181818" Foreground="#E6E6E6"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#D6D6D6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#0C0C0C"/>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#4FC1FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="新建连接(_N)" Click="NewSession_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="连接选中会话" Click="ConnectSelected_Click"/>
                <Separator/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="编辑选中会话" Click="EditProfile_Click"/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="删除选中会话" Click="DeleteProfile_Click"/>
                <Separator/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="导出用户配置…" Click="ExportConfig_Click"/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="导入用户配置…" Click="ImportConfig_Click"/>
                <Separator/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="会话(_S)">
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="重命名当前标签…" Click="RenameCurrentTab_Click"/>
                <MenuItem x:Name="DuplicateSessionMenuItem" Style="{StaticResource TextOnlyContextMenuItemStyle}"
                          Header="复制当前会话到新标签" Click="DuplicateCurrentTab_Click" IsEnabled="False"/>
                <Separator/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="开始记录日志" Click="StartLogging_Click"/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="停止记录日志" Click="StopLogging_Click"/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="打开日志目录" Click="OpenLogDirectory_Click"/>
                <Separator/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="断开当前会话" Click="DisconnectCurrent_Click"/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="关闭当前标签" Click="CloseCurrent_Click"/>
            </MenuItem>
            <MenuItem Header="终端(_T)">
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="终端外观…" Click="TerminalAppearance_Click"/>
                <Separator/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="查找…" Click="FindTerminal_Click" InputGestureText="Ctrl+Shift+F"/>
                <Separator/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="复制" Click="CopyTerminal_Click" InputGestureText="Ctrl+Shift+C"/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="粘贴" Click="PasteTerminal_Click" InputGestureText="Ctrl+Shift+V"/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="全选" Click="SelectAllTerminal_Click"/>
                <Separator/>
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="清屏" Click="ClearTerminal_Click"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Style="{StaticResource TextOnlyContextMenuItemStyle}" Header="关于 CrtSharp" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Background="#252526" Foreground="#F5F5F5" BorderBrush="#3F3F46">
            <ToolBar.Resources>
                <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button">
                    <Setter Property="Foreground" Value="#F5F5F5"/>
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="BorderBrush" Value="#4A4A4A"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Margin" Value="1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="2"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#454545"/>
                                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#777777"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#0E639C"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ToolBar.Resources>
            <Button Content="＋ 新建" Click="NewSession_Click" ToolTip="新建连接 (Ctrl+N)"/>
            <Button Content="▶ 连接" Click="ConnectSelected_Click" ToolTip="连接左侧选中的会话"/>
            <Button Content="✎ 编辑" Click="EditProfile_Click" ToolTip="编辑左侧选中的会话（不连接）"/>
            <Separator/>
            <Button x:Name="DuplicateSessionButton" Content="▣ 复制会话"
                    Click="DuplicateCurrentTab_Click" ToolTip="把当前标签的连接复制到新标签"
                    IsEnabled="False"/>
            <Button Content="● 日志" Click="ToggleLogging_Click" ToolTip="开始或停止记录当前标签日志"/>
            <Button Content="■ 断开" Click="DisconnectCurrent_Click"/>
            <Separator/>
            <Button Content="复制" Click="CopyTerminal_Click" ToolTip="复制选中内容 (Ctrl+Shift+C)"/>
            <Button Content="粘贴" Click="PasteTerminal_Click" ToolTip="粘贴 (Ctrl+Shift+V)"/>
            <Button Content="清屏" Click="ClearTerminal_Click"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Background="#007ACC" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TerminalSizeText" Text="-- × --"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="170"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,10,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="会话管理器" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="＋" Padding="7,2" Click="NewSession_Click" ToolTip="新建连接"/>
                    </Grid>
                    <ListBox x:Name="SessionList" Margin="6" Background="#252526" Foreground="#EEEEEE"
                             BorderThickness="0" MouseDoubleClick="SessionList_MouseDoubleClick"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="SessionList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="SessionList_PreviewMouseMove"
                             DragOver="SessionList_DragOver"
                             Drop="SessionList_Drop"
                             PreviewMouseRightButtonDown="SessionList_PreviewMouseRightButtonDown">
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="SessionContextMenu" Opened="SessionContextMenu_Opened">
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource TextOnlyContextMenuItemStyle}"/>
                                </ContextMenu.Resources>
                                <MenuItem Header="连接" Click="ConnectSelected_Click"/>
                                <Separator/>
                                <MenuItem Header="编辑…" Click="EditProfile_Click"/>
                                <Separator/>
                                <MenuItem Header="删除" Click="DeleteProfile_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,6" Width="220">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayTarget}" Foreground="#AAAAAA" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#3A3A3A" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Protocol}" FontSize="10" Foreground="#CCCCCC"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#3F3F46"/>

            <Grid Grid.Column="2" Background="#0C0C0C">
                <TabControl x:Name="TerminalTabs" Background="#0C0C0C" BorderThickness="0"
                            AllowDrop="True"
                            SelectionChanged="TerminalTabs_SelectionChanged"
                            PreviewMouseLeftButtonDown="TerminalTabs_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="TerminalTabs_PreviewMouseMove"
                            GiveFeedback="TerminalTabs_GiveFeedback"
                            QueryContinueDrag="TerminalTabs_QueryContinueDrag"
                            DragOver="TerminalTabs_DragOver"
                            Drop="TerminalTabs_Drop"/>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="CrtSharp" FontSize="34" FontWeight="Light" Foreground="#777777" HorizontalAlignment="Center"/>
                    <TextBlock Text="双击左侧会话，或按 Ctrl+N 新建连接" Margin="0,12,0,0" Foreground="#666666"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="NewCommand_Executed"/>
    </Window.CommandBindings>
</Window>
