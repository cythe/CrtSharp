<Window x:Class="CrtSharp.TerminalSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="终端外观" Height="500" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#202020" Foreground="#F0F0F0">
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#111111"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#111111"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F0F0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,13"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                <Grid>
                                    <ContentPresenter Margin="9,4,34,4" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="#F5F5F5" IsHitTestVisible="False"/>
                                    <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,11,0" Fill="#F5F5F5"
                                          Data="M 0 0 L 8 0 L 4 5 Z" IsHitTestVisible="False"/>
                                    <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#333333" BorderBrush="#666666" BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#0E8AD0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0E639C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#094771"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="字体"/>
            <ComboBox x:Name="FontFamilyBox" SelectionChanged="Appearance_Changed"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="字号"/>
                <ComboBox x:Name="FontSizeBox" SelectionChanged="Appearance_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="主题颜色"/>
                <ComboBox x:Name="ThemeBox" DisplayMemberPath="Display" SelectedValuePath="Value"
                          SelectionChanged="Appearance_Changed"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="光标样式"/>
                <ComboBox x:Name="CursorStyleBox" DisplayMemberPath="Display" SelectedValuePath="Value"
                          SelectionChanged="Appearance_Changed"/>
            </StackPanel>
            <CheckBox x:Name="CursorBlinkBox" Grid.Column="2" Content="光标闪烁"
                      Foreground="#F0F0F0" VerticalAlignment="Center" Margin="0,12,0,0"/>
        </Grid>

        <Border x:Name="PreviewBorder" Grid.Row="3" Margin="0,5,0,18" Padding="16"
                BorderBrush="#666666" BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="预览（可编辑，内容随会话保存）" FontSize="11" Foreground="#AAAAAA"/>
                <TextBox x:Name="PreviewText" Margin="0,10,0,0" MinHeight="82"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent" Foreground="#CCCCCC" CaretBrush="#FFFFFF"
                         BorderThickness="0" Padding="0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True"/>
            <Button Content="应用" IsDefault="True" Click="Apply_Click"
                    Background="#0E639C" BorderBrush="#1177BB"/>
        </StackPanel>
    </Grid>
</Window>
