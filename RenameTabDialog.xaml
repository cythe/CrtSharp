<Window x:Class="CrtSharp.RenameTabDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名标签" Height="190" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#202020" Foreground="#F0F0F0">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="标签名称" Foreground="#F0F0F0"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,6,0,6" Padding="8,6"
                 Background="#333333" Foreground="White" CaretBrush="White" BorderBrush="#555555"
                 MaxLength="80"/>
        <TextBlock x:Name="ValidationText" Grid.Row="2" Foreground="#FF7777"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Padding="16,6" Margin="0,0,8,0"
                    Background="#333333" Foreground="White" BorderBrush="#555555"/>
            <Button Content="确定" IsDefault="True" Padding="16,6" Click="Confirm_Click"
                    Background="#0E639C" Foreground="White" BorderBrush="#1177BB"/>
        </StackPanel>
    </Grid>
</Window>
